        "rowhandoff_can_consume",
        "row_gate_enable",
        "row_is_interior"
      ]
    },
    {
      "signal": "rowhandoff_miss_pulse",
      "formula": "!rowhandoff_trace.rowhandoff_can_consume && row_gate_enable && row_is_interior",
      "depends_on": [
        "rowhandoff_can_consume",
        "row_gate_enable",
        "row_is_interior"
      ]
    },
    {
      "signal": "rowhandoff_invalidate_pulse",
      "formula": "row_advance_done && rowhandoff_valid && (!row_gate_enable || !row_is_interior)",
      "depends_on": [
        "row_advance_done",
        "rowhandoff_valid",
        "row_gate_enable",
        "row_is_interior"
      ]
    },
    {
      "signal": "rowhandoff_tail_hit_pulse",
      "formula": "rowhandoff_hit_pulse && (out_y_q >= 6'd24)",
      "depends_on": [
        "rowhandoff_hit_pulse",
        "out_y_q"
      ]
    }
