/*
 * PROJECT_LOCAL_SELF_RESEARCH_NOT_GOOGLE_OFFICIAL
 *
 * ZCU104 GestureFlow NPU: device-tree additions for the Linux-side userspace
 * driver.
 *
 * Installed to:
 *   project-spec/meta-user/recipes-bsp/device-tree/files/system-user.dtsi
 *
 * ---------------------------------------------------------------------------
 * WHY a memory-map hole (NOT a `no-map` reserved-memory node)
 *
 * The NPU's M_AXI master is wired to PS S_AXI_HP0_FPD -- a NON-COHERENT port.
 * The userspace driver therefore wants its scratch buffers mapped NON-CACHED so
 * that neither side needs any cache maintenance.  The way to get that from
 * /dev/mem on arm64 is to make 0x70000000 NOT be System RAM: leave it out of
 * the memory node entirely.  /dev/mem then maps it with pgprot_noncached and no
 * flush/invalidate is needed on either side.
 *
 * We originally reserved this with a `no-map` reserved-memory node.  That is
 * WRONG on this kernel (6.1, first caught on real hardware 2026-09-12):
 *
 *   - `no-map` calls memblock_mark_nomap(), which keeps the range as RAM but
 *     drops it from the kernel linear map;
 *   - /dev/mem still sees pfn_valid() == true, so it maps the range CACHEABLE;
 *   - but there is no linear-map backing, so the very first access hangs the
 *     CPU (rcu_sched stall) / raises SIGBUS.
 *
 *   The comment here used to claim no-map == memblock_remove(); that was the
 *   misunderstanding.  See plnx/PITFALLS.md #14.
 *
 * Address choice: the original memory node ends at 0x7FF00000 (2 GiB minus the
 * 1 MiB TZ tail).  We split it around 0x70000000, leaving a 16 MiB hole:
 *     0x00000000 .. 0x70000000      (1.75 GiB)
 *     0x71000000 .. 0x7FF00000      (~239 MiB)
 * The hole is still physical DDR (the controller decodes the whole 2 GiB), so
 * the NPU's HP0 master still reaches it; only the kernel no longer treats it as
 * RAM.
 *
 * Size: the current network needs ~148 KB of weights and ~425 KB of
 * activations.  16 MB is deliberate over-allocation so that the follow-up
 * double-buffered pipeline (capture and compute overlapping) fits, with room to
 * grow.
 *
 * The matching userspace layout is defined in linux/gf_npu.h (GF_BUF_*).
 * ---------------------------------------------------------------------------
 */

/include/ "system-conf.dtsi"

/ {
	/*
	 * Split the memory node around the 16 MiB NPU scratch hole at
	 * 0x70000000.  This overrides the single-bank memory node generated from
	 * the XSA.  The hole is what makes /dev/mem map the scratch non-cached.
	 */
	memory@0 {
		device_type = "memory";
		reg = <0x0 0x00000000 0x0 0x70000000>,	/* 0 .. 1.75 GiB */
		      <0x0 0x71000000 0x0 0x0EF00000>;	/* 1.75 GiB+16 MiB .. 2 GiB-1 MiB */
	};
};
