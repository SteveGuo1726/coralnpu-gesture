+"""Replay gesture_static_cnn_v1 Conv2D shapes in NPUSim."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+from bazel_tools.tools.python.runfiles import runfiles
+from coralnpu_v2_sim_utils import CoralNPUV2Simulator
+
+
+STATIC_CNN_3X3_CASES = [
+    {
+        "layer_name": "conv1_3x3_a",
+        "out_h": 64,
+        "out_w": 64,
+        "in_d": 3,
+        "out_d": 16,
+        "filter_hw": 3,
+        "expected_current_path": "3x3_oc_vectorized",
+    },
+    {
+        "layer_name": "conv1_3x3_b",
+        "out_h": 64,
+        "out_w": 64,
+        "in_d": 16,
+        "out_d": 16,
+        "filter_hw": 3,
+        "expected_current_path": "3x3_oc_vectorized",
+    },
+    {
+        "layer_name": "conv2_3x3_a",
+        "out_h": 32,
+        "out_w": 32,
+        "in_d": 16,
+        "out_d": 32,
+        "filter_hw": 3,
+        "expected_current_path": "3x3_oc_vectorized",
+    },
+    {
+        "layer_name": "conv2_3x3_b",
+        "out_h": 32,
+        "out_w": 32,
+        "in_d": 32,
+        "out_d": 32,
+        "filter_hw": 3,
+        "expected_current_path": "3x3_oc_vectorized",
+    },
+    {
+        "layer_name": "conv3_3x3_a",
+        "out_h": 16,
+        "out_w": 16,
+        "in_d": 32,
+        "out_d": 64,
+        "filter_hw": 3,
+        "expected_current_path": "3x3_oc_vectorized",
+    },
+    {
+        "layer_name": "conv3_3x3_b",
+        "out_h": 16,
+        "out_w": 16,
+        "in_d": 64,
+        "out_d": 64,
+        "filter_hw": 3,
+        "expected_current_path": "3x3_oc_vectorized",
+    },
+]
+
+
+class MpactConv2DTest:
+    def __init__(
+        self,
+        *,
+        in_d: int,
+        out_d: int,
+        stride: int = 1,
+        out_h: int = 4,
+        out_w: int = 4,
+        filter_hw: int = 4,
+        seed: int = 20260601,
+    ):
+        self.stride = stride
+        self.seed = seed
+        in_h = out_h * stride
+        in_w = out_w * stride
+        self.in_shape = np.array([1, in_h, in_w, in_d], dtype=np.uint32)
+        self.f_shape = np.array([out_d, filter_hw, filter_hw, in_d], dtype=np.uint32)
+        self.bias_shape = np.array([out_d], dtype=np.uint32)
+        self.out_shape = np.array([1, out_h, out_w, out_d], dtype=np.uint32)
+        self.out_size = int(np.prod(self.out_shape))
+        self.macs = int(out_h * out_w * out_d * filter_hw * filter_hw * in_d)
+
+        r = runfiles.Create()
+        self.elf_file = r.Rlocation(
+            "coralnpu_hw/tests/cocotb/tutorial/tfmicro/conv2d_test.elf"
+        )
+
+    def load_and_populate_input(self):
+        self.npu_sim = CoralNPUV2Simulator(highmem_ld=True)
+        self.entry_point, self.symbol_map = self.npu_sim.get_elf_entry_and_symbol(
+            self.elf_file,
+            [
+                "impl",
+                "run_ref",
+                "run_opt",
+                "stride",
+                "filter_shape",
+                "filter_data",
+                "bias_shape",
+                "bias_data",
+                "input_shape",
+                "input_data",
+                "output_shape",
+                "output_data",
+            ],
+        )
+        self.npu_sim.load_program(self.elf_file)
+        rng = np.random.default_rng(self.seed)
+        filter_data = rng.integers(-128, 128, self.f_shape, dtype=np.int8).flatten()
+        bias_data = rng.integers(-100000, 100000, self.out_shape[3], dtype=np.int32)
+        input_data = rng.integers(-128, 128, self.in_shape, dtype=np.int8).flatten()
+
+        self.npu_sim.write_word(self.symbol_map["stride"], np.uint32(self.stride))
+        self.npu_sim.write_memory(self.symbol_map["filter_shape"], self.f_shape)
+        self.npu_sim.write_memory(self.symbol_map["filter_data"], filter_data)
+        self.npu_sim.write_memory(self.symbol_map["bias_shape"], self.bias_shape)
+        self.npu_sim.write_memory(self.symbol_map["bias_data"], bias_data)
+        self.npu_sim.write_memory(self.symbol_map["input_shape"], self.in_shape)
+        self.npu_sim.write_memory(self.symbol_map["input_data"], input_data)
+        self.npu_sim.write_memory(self.symbol_map["output_shape"], self.out_shape)
+
+    def run(self, fun_ptr: str):
+        self.npu_sim.write_register("pc", self.entry_point)
+        self.npu_sim.write_ptr(self.symbol_map["impl"], self.symbol_map[fun_ptr])
+        self.npu_sim.write_memory(
+            self.symbol_map["output_data"], np.zeros([self.out_size], dtype=np.int8)
+        )
+        self.npu_sim.run()
+        self.npu_sim.wait()
+        cycles = self.npu_sim.get_cycle_count()
+        outputs = self.npu_sim.read_memory(
+            self.symbol_map["output_data"], self.out_size
+        ).view(np.int8)
+        return cycles, outputs
+
+    def test(self, *, verify_ref: bool):
+        opt_cycles, opt_outputs = self.run("run_opt")
+        ref_cycles = None
+        correct = None
+        if verify_ref:
+            ref_cycles, ref_outputs = self.run("run_ref")
+            correct = bool((opt_outputs == ref_outputs).all())
+            if not correct:
+                raise AssertionError("optimized output differs from reference output")
+        return ref_cycles, opt_cycles, correct
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--json_out", help="Optional JSON report path.")
+    parser.add_argument(
+        "--skip_ref_for_fallback",
+        action="store_true",
+        help="Run fallback-only layers without reference replay to save time.",
+    )
+    return parser.parse_args()
+
+
+def run_cases(args: argparse.Namespace) -> dict:
+    results = []
+    for index, case in enumerate(STATIC_CNN_3X3_CASES):
+        print(
+            f"{case['layer_name']} "
+            f"h={case['out_h']} w={case['out_w']} "
+            f"in_d={case['in_d']} out_d={case['out_d']} "
+            f"path={case['expected_current_path']}",
+            flush=True,
+        )
+        test = MpactConv2DTest(
+            in_d=case["in_d"],
+            out_d=case["out_d"],
+            stride=1,
+            out_h=case["out_h"],
+            out_w=case["out_w"],
+            filter_hw=case["filter_hw"],
+            seed=20260601 + index,
+        )
+        test.load_and_populate_input()
+        verify_ref = not (
+            args.skip_ref_for_fallback
+            and case["expected_current_path"] == "reference_fallback"
+        )
+        ref_cycles, opt_cycles, correct = test.test(verify_ref=verify_ref)
+        speedup = (ref_cycles / opt_cycles) if ref_cycles and opt_cycles else None
+        result = {
+            **case,
+            "input_shape": test.in_shape.astype(int).tolist(),
+            "filter_shape": test.f_shape.astype(int).tolist(),
+            "output_shape": test.out_shape.astype(int).tolist(),
+            "estimated_macs": test.macs,
+            "ref_cycles": ref_cycles,
+            "opt_cycles": opt_cycles,
+            "correct_vs_ref": correct,
+            "speedup": speedup,
+            "opt_cycles_per_mac": opt_cycles / test.macs,
+            "ref_cycles_per_mac": (ref_cycles / test.macs) if ref_cycles else None,
+        }
+        print(
+            f"  ref_cycles={ref_cycles} opt_cycles={opt_cycles} "
+            f"speedup={speedup if speedup is not None else 'n/a'}",
+            flush=True,
+        )
+        results.append(result)
+
+    opt_total = sum(item["opt_cycles"] for item in results)
+    ref_items = [item for item in results if item["ref_cycles"] is not None]
+    ref_total = sum(item["ref_cycles"] for item in ref_items)
+    report = {
+        "model": "gesture_static_cnn_v1",
+        "scope": "3x3 Conv2D layers from the static CNN baseline",
+        "results": results,
+        "totals": {
+            "estimated_macs": sum(item["estimated_macs"] for item in results),
+            "opt_cycles": opt_total,
+            "ref_cycles_for_verified_layers": ref_total,
+            "verified_layer_count": len(ref_items),
+            "layer_count": len(results),
+            "speedup_for_verified_layers": (ref_total / opt_total)
+            if len(ref_items) == len(results) and opt_total
+            else None,
+        },
+    }
+    return report
+
+
+def main() -> None:
+    args = parse_args()
+    report = run_cases(args)
+    if args.json_out:
+        out_path = Path(args.json_out)
+        out_path.parent.mkdir(parents=True, exist_ok=True)
+        out_path.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
+        print(f"Wrote {out_path}", flush=True)
+
+
+if __name__ == "__main__":
+    main()
